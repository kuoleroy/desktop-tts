{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-tts",
  "version": "0.1.0",
  "identifier": "com.kuoleroy.desktop-tts",
  "build": {
    "frontendDist": "../assets/web",
    "devUrl": "http://localhost:8877",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "3D Pet",
        "width": 240,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$CARGO_MANIFEST_DIR/../tts_cache/**", "$CARGO_MANIFEST_DIR/../models/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}