{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-tts",
  "version": "0.1.0",
  "identifier": "com.kuoleroy.desktop-tts",
  "build": {
    "frontendDist": "../assets/web",
    "devUrl": "http://localhost:8877",
    "beforeDevCommand": "python dev_server.py",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "3D Pet",
        "width": 240,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "panel",
        "title": "Pet Panel",
        "url": "panel.html",
        "width": 280,
        "height": 400,
        "visible": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "lockbtn",
        "title": "Pet Lock",
        "url": "lock.html",
        "width": 36,
        "height": 36,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"]
  }
}